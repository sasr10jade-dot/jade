# VOICEMAP — environment variables
# Copy to .env and fill in real values. .env is gitignored.

# --- Database (Prisma) ---
# Postgres everywhere (dev and prod) — prisma/schema.prisma provider is "postgresql".
# Local dev: point this at your own Postgres instance (Neon/Supabase/local Docker all work).
# On Vercel: add a Postgres storage integration from the project's Storage tab and it
# injects this for you — no manual copy-paste needed.
DATABASE_URL="postgresql://user:password@host:5432/voicemap"

# --- Auth (Auth.js v5) ---
# AUTH_URL intentionally unset — trustHost:true (src/auth.config.ts) derives it from
# the request's Host header. Set AUTH_URL explicitly only for a fixed production domain.
AUTH_SECRET="replace-with-openssl-rand--base64-32"

# --- File storage (Track uploads — FR-01) ---
# REQUIRED on Vercel: serverless functions have no writable/persistent disk, so the
# local-disk fallback (public/uploads) silently breaks in production. Set all four
# before deploying — local dev can leave them blank to use the disk fallback.
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Payments (Toss Payments — FR-05 / Section 12 escrow) ---
TOSS_CLIENT_KEY=""
TOSS_SECRET_KEY=""
