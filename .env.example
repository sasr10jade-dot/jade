# VOICEMAP — environment variables
# Copy to .env and fill in real values. .env is gitignored.

# --- Database (Prisma) ---
# Postgres everywhere (dev and prod) — prisma/schema.prisma provider is "postgresql".
# Local dev: point this at your own Postgres instance (Neon/Supabase/local Docker all work).
# On Vercel: add a Postgres storage integration from the project's Storage tab and it
# injects this for you — no manual copy-paste needed.
DATABASE_URL="postgresql://user:password@host:5432/voicemap"

# --- Auth (Auth.js v5) ---
# AUTH_URL intentionally unset — trustHost:true (src/auth.config.ts) derives it from
# the request's Host header. Set AUTH_URL explicitly only for a fixed production domain.
AUTH_SECRET="replace-with-openssl-rand--base64-32"

# --- File storage (Track uploads — FR-01) ---
# REQUIRED on Vercel: serverless functions have no writable/persistent disk, so the
# local-disk fallback (public/uploads) silently breaks in production. Local dev can
# leave everything below blank to use the disk fallback. storage.ts checks backends
# in this order: Vercel Blob, then S3-compatible, then local disk.
#
# Preferred: Vercel Blob (free up to 1GB/month on Hobby, zero-config on Vercel).
# Don't set this by hand — from the Vercel dashboard, open the project's Storage tab,
# create/connect a Blob store, and it injects BLOB_READ_WRITE_TOKEN automatically.
# BLOB_READ_WRITE_TOKEN=""
#
# Alternative: an S3-compatible provider (AWS S3, Cloudflare R2, etc). For Cloudflare R2:
#   S3_BUCKET             = the R2 bucket name
#   S3_REGION             = "auto"
#   S3_ACCESS_KEY_ID       / S3_SECRET_ACCESS_KEY = from an R2 API token
#   S3_ENDPOINT           = https://<account-id>.r2.cloudflarestorage.com
#   S3_PUBLIC_URL         = the bucket's public R2.dev URL (or a custom domain)
# For real AWS S3, leave S3_ENDPOINT / S3_PUBLIC_URL unset.
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_PUBLIC_URL=""

# --- Payments (Toss Payments — FR-05 / Section 12 escrow) ---
TOSS_CLIENT_KEY=""
TOSS_SECRET_KEY=""

# --- Seed script (prisma/seed.ts) ---
# Real creator account upserted by the seed — never hardcode these in source.
SEED_CREATOR_EMAIL=""
SEED_CREATOR_PASSWORD=""
